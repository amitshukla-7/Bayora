{
  "name": "bayora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"vite\"",
    "server": "node --experimental-strip-types server/index.mjs",
    "record-cache": "node --experimental-strip-types scripts/record_cache.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run && node scripts/test_engine.mjs",
    "test:unit": "vitest run",
    "test:200": "node --experimental-strip-types scripts/test_200_cases.mjs",
    "verify": "node --experimental-strip-types scripts/verify.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "concurrently": "^10.0.6",
    "hono": "^4.13.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.55.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
